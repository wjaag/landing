# Copy this file to .env before starting the stack.
# Do not use these passwords outside local development.
WP_PORT=8070
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me-local-db-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password

# WordPress development flags
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=1
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=true

# Optional tool ports (profile: tools)
ADMINER_PORT=8071
MAILPIT_UI_PORT=8025
